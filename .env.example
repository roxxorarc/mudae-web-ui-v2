# === DATABASE ===
POSTGRES_USER="mudae"
POSTGRES_PASSWORD="change_me"
POSTGRES_DB="mudae"
# Host is `postgres` inside docker compose, `localhost` when running outside
DATABASE_URL="postgresql://mudae:change_me@postgres:5432/mudae"

# === SUPABASE ===
# Found in Supabase Settings -> API
SUPABASE_URL="https://[YOUR_REF].supabase.co"
SUPABASE_ANON_KEY="your_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

# === DISCORD BOT ===
DISCORD_TOKEN="your_bot_token"
# Comma-separated list of channel IDs where the bot should listen to Mudae
CHANNEL_IDS="11111111111111,22222222222222"

# VITE_API_URL="http://localhost:8000"