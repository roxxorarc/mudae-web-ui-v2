# === DATABASE ===
POSTGRES_USER="mudae"
POSTGRES_PASSWORD="change_me"
POSTGRES_DB="mudae"
# Host is `postgres` inside docker compose, `localhost` when running outside
DATABASE_URL="postgresql://mudae:change_me@postgres:5432/mudae"

# === DISCORD BOT ===
DISCORD_TOKEN="your_bot_token"
# Comma-separated list of channel IDs where the bot should listen to Mudae
CHANNEL_IDS="11111111111111,22222222222222"

# === DISCORD OAUTH (same application as the bot) ===
# Found in Discord Developer Portal -> OAuth2
# Register the redirect URI: ${PUBLIC_API_URL}/api/auth/callback
DISCORD_CLIENT_ID="your_app_client_id"
DISCORD_CLIENT_SECRET="your_app_client_secret"

# === API / SESSION ===
# Random secret for signing session tokens (e.g. `openssl rand -hex 32`)
SESSION_SECRET="change_me"
# Public base URL of the API (used for the OAuth redirect)
PUBLIC_API_URL="http://localhost:8000"
# Where the browser lands after login (frontend origin)
FRONTEND_URL="http://localhost:5175"
# Set to true when serving over HTTPS
COOKIE_SECURE="false"